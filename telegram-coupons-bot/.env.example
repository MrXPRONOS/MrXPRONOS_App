# Créer un bot avec @BotFather et renseigner le token SECRET dans .env
BOT_TOKEN=METTRE_ICI_LE_TOKEN
# Identifiants numériques Telegram des administrateurs, séparés par virgules
ADMIN_IDS=123456789
BOT_TITLE=XPRONOS 4+
DB_PATH=./data/coupons_v4.db

# Points virtuels (XP). Aucun FCFA, aucun paiement, aucun retrait.
REFERRAL_POINTS=30
BONUS_POINTS=5
BONUS_COOLDOWN_HOURS=2
BONUS_DAILY_CAP_POINTS=10

# Canaux obligatoires. Garder [] pour désactiver l'obligation (les primes de parrainage
# seront alors désactivées par sécurité).
# Le bot doit être ADMINISTRATEUR dans chaque canal pour vérifier les abonnements.
# Pour un canal public id=@moncanal ; pour un canal privé id=-100... (jamais l'URL).
REQUIRED_CHANNELS_JSON=[]

# Site optionnel pour les contenus football
SITE_URL=https://mrxpronos.github.io/MrXPRONOS_App/
